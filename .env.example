# Root .env for docker-compose.yml — copy to .env and fill in real values.
# These variables are injected into Docker containers.
# Do NOT commit .env to version control.

# ── GitHub OAuth ───────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3001/auth/callback

# ── JWT Secrets ────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your-access-token-secret-min-64-chars
JWT_REFRESH_SECRET=your-refresh-token-secret-min-64-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_PASSWORD=mentorqa_neo4j

# ── App ────────────────────────────────────────────────────────────────────────
WEB_URL=http://localhost:3000

# ── AI ─────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_MAX_ENRICH_PER_RUN=12
GEMINI_ENRICH_BATCH_SIZE=4
DEBUG_MENTOR_PROMPTS=false
MENTOR_DRY_RUN=false

TOKEN_ENCRYPTION_KEY=replace_with_32_byte_hex_string

