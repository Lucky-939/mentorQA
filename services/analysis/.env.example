# Required variables for services/analysis
# Copy this file to .env and fill in the values.

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://mentorqa:mentorqa@postgres:5432/mentorqa

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ── AI ─────────────────────────────────────────────────────────────────────────
# Google Gemini Flash API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
