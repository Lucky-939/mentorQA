# Required variables for apps/api
# Copy this file to .env and fill in the values.

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# For Docker Compose (service name "postgres" as host):
DATABASE_URL=postgresql://mentorqa:mentorqa@postgres:5432/mentorqa
# For running outside Docker (localhost):
# DATABASE_URL=postgresql://mentorqa:mentorqa@localhost:5433/mentorqa

# ── Redis ──────────────────────────────────────────────────────────────────────
# For Docker Compose (service name "redis" as host):
# REDIS_URL=redis://redis:6379
# For running outside Docker (localhost):
REDIS_URL=redis://localhost:6380

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ── GitHub OAuth App ──────────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers → "New OAuth App"
# Homepage URL:        http://localhost:3000
# Authorization callback URL: http://localhost:3001/auth/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3001/auth/callback

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your-access-token-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-token-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── App ────────────────────────────────────────────────────────────────────────
WEB_URL=http://localhost:3000
PORT=3001
NODE_ENV=development

TOKEN_ENCRYPTION_KEY=replace_with_32_byte_hex_string
